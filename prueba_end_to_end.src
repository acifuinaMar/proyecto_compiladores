program {
    int[] nums = [5, 8, 13, 21, 34];

    int fibonacci(int n) {
        si (n <= 1) {
            return n;
        }
        return fibonacci(n - 1) + fibonacci(n - 2);
    }

    int i = 0;
    int total = 0;

    while (i < 5) {
        int r = nums[i] % 2;

        si (r == 0) {
            total = total + nums[i];
        }

        i = i + 1;
    }

    int fib = fibonacci(0);

    int base = (int) 20;
    int extra = total > 40 ? 8 : 0;

    int opcion = 2;
    int marcador = 0;

    switch (opcion) {
        case 1:
            marcador = 7;
            break;

        case 2:
            marcador = 7;
            break;

        default:
            marcador = 7;
    }

    print(fib);
    print(total);
    print(base + extra + total);
    print(marcador);
}